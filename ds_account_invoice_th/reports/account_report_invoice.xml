<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ds_l10n_th_report_invoice_document" inherit_id="l10n_th.report_invoice_document">
        <xpath expr="//t[@t-set='layout_document_title']" position="before">
            <t t-set="display_payment_template" 
                t-value="o.company_id.account_fiscal_country_id.code == 'TH' 
                        and not commercial_invoice 
                        and print_with_payments 
                        and o.x_ds_tax_invoice_date" />
        </xpath>
        <!-- show Tax in title -->
        <xpath expr="//t[@name='invoice_title']" position="replace">
            <t name="invoice_title" t-out="'Tax Invoice' if display_payment_template else 'Invoice'"/>
        </xpath>
        <!-- add suffix 'T' -->
        <xpath expr="//span[@t-field='o.name']" position="replace">
            <t t-if="display_payment_template">
                <span t-out="o.name + 'T'"/>
            </t>
            <t t-else="">
                <span t-if="o.name and o.name != '/'" t-field="o.name">INV/2023/0001</span>
            </t>
        </xpath>
        <!-- show Tax Invoice Date instead of Invoice Date -->
        <xpath expr="//div[@t-field='o.invoice_date']" position="replace">
            <t t-if="not o.partner_id.ds_no_date">
                <t t-if="display_payment_template">
                    <div t-field="o.x_ds_tax_invoice_date"/>
                </t>
                <t t-else="">
                    <div t-field="o.invoice_date">2023-09-12</div>
                </t>
            </t>
        </xpath>
        <!-- remove Due Date -->
        <xpath expr="//div[@name='due_date']" position="replace">
            <t t-if="not o.partner_id.ds_no_date">
                <t t-if="not display_payment_template">
                    <div class="col" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">
                        <strong>Due Date</strong>
                        <div t-field="o.invoice_date_due">2023-10-31</div>
                    </div>
                </t>
            </t>
        </xpath>
        <!-- remove Delivery Date -->
        <xpath expr="//div[@name='delivery_date']" position="replace">
            <t t-if="not o.partner_id.ds_no_date">
                <div class="col" t-if="o.delivery_date" name="delivery_date">
                    <strong>Delivery Date</strong>
                    <div t-field="o.delivery_date">2023-09-25</div>
                </div>
            </t>
        </xpath>

    </template>
        
</odoo>
