<odoo>
    <record id="ds_view_move_form_auto_send" model="ir.ui.view">
        <field name="name">account.move.form.auto.send</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='checked']" position="before">
                <field name="ds_auto_send" invisible="auto_post == 'no' or move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>